<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#CC000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="@drawable/overlay_background">

        <!-- Warning Icon -->
        <TextView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="⚠️"
            android:textSize="48sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/overlay_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️ BREAK ENDING!"
            android:textSize="28sp"
            android:textColor="#FF0000"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/overlay_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Return to app in"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />

        <!-- Countdown -->
        <TextView
            android:id="@+id/overlay_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10"
            android:textSize="72sp"
            android:textColor="#FFD700"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="seconds"
            android:textSize="16sp"
            android:textColor="#FFFFFF" />

        <!-- Event_Maneger Indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊 ALARM RINGING"
                android:textColor="#FF4444"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Return Button - THE ONLY ESCAPE -->
        <Button
            android:id="@+id/overlay_return_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🔒 RETURN TO APP"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/button_return"
            android:layout_marginTop="24dp"
            android:elevation="8dp"
            android:padding="16dp" />

        <!-- Warning Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️ YOU CANNOT DISMISS THIS WARNING"
            android:textColor="#FF4444"
            android:textSize="12sp"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</LinearLayout>